# Copy this file to .env for local development. Never commit .env.
#
# Everything is optional in development: with nothing set, the API starts an
# in-memory MongoDB (data resets on restart) and uses a built-in dev secret.

# MongoDB connection string. Required in production.
#   Local MongoDB:  mongodb://127.0.0.1:27017/queue-desk
#   MongoDB Atlas:  mongodb+srv://USER:PASSWORD@cluster.mongodb.net/queue-desk
# MONGODB_URI=mongodb://127.0.0.1:27017/queue-desk

# Signs the login session cookie. Required in production. Generate one with:
#   openssl rand -base64 32
# JWT_SECRET=replace-with-a-long-random-string

# Public URL of the app (used in password reset links). Default: http://localhost:3000
# APP_URL=https://your-app.onrender.com

# API port. Default: 4000
# PORT=4000

# Optional: send real password reset emails through Resend (needs a verified domain to
# email anyone other than yourself). Without these, the reset link is printed in the
# server console during development.
# RESEND_API_KEY=
# RESET_EMAIL_FROM="Queue Desk <no-reply@your-domain.com>"

# DEMO SITES ONLY: show the password reset link on screen instead of emailing it, so a
# reviewer can try "Forgot password" without an inbox. Anyone who knows an email could
# then reset that account, so never enable this for real users.
# DEMO_SHOW_RESET_LINK=true
